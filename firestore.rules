rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myPublicId() {
      return userDoc().data.publicId;
    }

    function isActiveUser() {
      return isSignedIn()
        && userDoc().data.status == 'active'
        && userDoc().data.isWithdrawn == false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll([
          'publicId', 'nicknameSet', 'status', 'isWithdrawn', 'createdAt'
        ])
        && request.resource.data.publicId.matches('[A-Za-z][A-Za-z0-9]{15}')
        && request.resource.data.status == 'active';
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    match /public_ids/{publicId} {
      // Allow signed-in get so clients can check ID uniqueness (missing docs too).
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.authUid == request.auth.uid
        && publicId.matches('[A-Za-z][A-Za-z0-9]{15}');
      allow update: if isSignedIn()
        && resource.data.authUid == request.auth.uid;
      allow delete: if false;
    }

    match /diaries/{diaryId} {
      allow read: if isActiveUser() && resource.data.publicId == myPublicId();
      allow create: if isActiveUser()
        && request.resource.data.publicId == myPublicId();
      allow update: if isActiveUser()
        && resource.data.publicId == myPublicId();
      allow delete: if false;
    }

    match /scenarios/{scenarioId} {
      allow read: if isActiveUser() && resource.data.publicId == myPublicId();
      allow create: if isActiveUser()
        && request.resource.data.publicId == myPublicId();
      allow update: if isActiveUser()
        && resource.data.publicId == myPublicId();
      allow delete: if false;
    }

    match /comics/{comicId} {
      allow read: if isActiveUser() && resource.data.publicId == myPublicId();
      allow create: if isActiveUser()
        && request.resource.data.publicId == myPublicId()
        && request.resource.data.imageUrls.size() == 4
        && request.resource.data.storagePaths.size() == 4;
      allow update: if isActiveUser()
        && resource.data.publicId == myPublicId();
      allow delete: if false;
    }

    match /usage_daily/{docId} {
      allow read: if isActiveUser()
        && resource.data.publicId == myPublicId();
      allow create, update: if isActiveUser()
        && request.resource.data.publicId == myPublicId();
      allow delete: if false;
    }

    match /app_config/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Email/phone existence checks before login (no PII beyond hashed keys).
    match /auth_lookup/{lookupId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
