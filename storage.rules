rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // comics/{publicId}/{comicId}/panel_N.(png|jpg|webp)
    // Download URLs with tokens are used in the app; public read keeps gallery/result working for guests.
    match /comics/{publicId}/{comicId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && fileName.matches('panel_[1-4]\\.(webp|png|jpg|jpeg)|thumb\\.(webp|png|jpg|jpeg)')
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
